{
  "name": "mcp-fhir",
  "condition": "${find(request.uri.path, '^/mcp')}",

  "properties": {
    "gatewayUrl": "&{env['GATEWAY_URL']}",
    "mcpServerUrl": "&{env['MCP_SERVER_URL']}",
    "introspectUrl": "&{env['INTROSPECT_URL']}",
    "authorizationServerUri": "&{env['AUTHORIZATION_SERVER_URI']}",
    "agentFacingScope": "&{env['AGENT_FACING_SCOPE']}"
  },

  "baseURI": "&{mcpServerUrl}",

  "heap": [
    {
      "name": "SecretsStore",
      "type": "SystemAndEnvSecretStore",
      "config": { "format": "PLAIN" }
    },
    {
      "name": "IntrospectionProviderHandler",
      "type": "Chain",
      "config": {
        "filters": [
          {
            "name": "IntrospectionClientAuth",
            "type": "ClientSecretBasicAuthenticationFilter",
            "config": {
              "clientId": "${env['INTROSPECT_CLIENT_ID']}",
              "clientSecretId": "introspect.client.secret",
              "secretsProvider": "SecretsStore"
            }
          }
        ],
        "handler": "ClientHandler"
      }
    },
    {
      "name": "rsFilter",
      "type": "OAuth2ResourceServerFilter",
      "config": {
        "requireHttps": false,
        "scopes": [ "&{agentFacingScope}" ],
        "accessTokenResolver": {
          "type": "TokenIntrospectionAccessTokenResolver",
          "config": {
            "endpoint": "&{introspectUrl}",
            "providerHandler": "IntrospectionProviderHandler"
          }
        }
      }
    }
  ],

  "handler": {
    "type": "Chain",
    "config": {
      "filters": [
        {
          "type": "McpProtectionFilter",
          "config": {
            "resourceId": "&{gatewayUrl}/mcp",
            "authorizationServerUri": "&{authorizationServerUri}",
            "resourceServerFilter": "rsFilter",
            "supportedScopes": [ "&{agentFacingScope}" ],
            "resourceIdPointer": "/aud"
          }
        },
        {
          "type": "McpValidationFilter",
          "config": {
            "acceptedOrigins": ".*"
          }
        }
      ],
      "handler": {
        "type": "ReverseProxyHandler",
        "config": {
          "soTimeout": "1 hour"
        }
      }
    }
  }
}
